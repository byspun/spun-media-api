run_resolve() {
  local namespace="" id type path
  while (($#)); do
    case "$1" in
      --list) require_base_config; request GET resolve admin; return ;;
      --tmdb|--imdb|--tvdb|--anilist|--mal|--kitsu|--moviebox) namespace="${1#--}" ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --resolve; return ;;
      *) usage_error "Unknown resolve option: $1" ;;
    esac
    shift
  done
  [[ -n "$namespace" ]] || namespace="$(prompt_required Namespace)"
  id="$(prompt_required Identifier)"
  path="resolve/$(urlencode "$namespace")?id=$(urlencode "$id")"
  if [[ "$PARAMS" == true ]]; then
    type="$(prompt_optional Type)"
    path="$(append_query "$path" type "$type")"
  fi
  request GET "$path" admin
}

run_home() {
  local type="all" path
  while (($#)); do
    case "$1" in
      --movie) type=movie ;;
      --tv) type=tv ;;
      --anime) type=anime ;;
      --status) path='home/status' ;;
      --raw) RAW=true ;;
      --help) help_group --home; return ;;
      --*) usage_error "Unknown home option: $1" ;;
    esac
    shift
  done
  if [[ -z "${path:-}" ]]; then
    [[ "$type" == all ]] && path='home' || path="home/$type"
  fi
