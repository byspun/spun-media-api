run_proxy() {
  local mode="" token path
  while (($#)); do
    case "$1" in
      --stream) mode=stream ;;
      --subtitles) mode=subtitles ;;
      --raw) RAW=true ;;
      --help) help_group --proxy; return ;;
      *) usage_error "Unknown proxy option: $1" ;;
    esac
    shift
  done
  [[ -n "$mode" ]] || { mode="$(prompt_required 'Proxy type [stream/subtitles]')"; }
  [[ "$mode" == stream || "$mode" == subtitles ]] || usage_error 'Proxy type must be stream or subtitles.'
  token="$(prompt_secret_required 'Proxy token')"
  path="proxy/$mode?t=$(urlencode "$token")"
  request GET "$path" admin
}

body_account_create() {
  local auth_subject email name status
  auth_subject="$(prompt_required 'Auth subject')"
  read -r -p 'Email [optional]: ' email
  read -r -p 'Name [optional]: ' name
  read -r -p 'Status [active]: ' status
  status="${status:-active}"
  jq -nc --arg auth_subject "$auth_subject" --arg email "$email" --arg name "$name" --arg status "$status" '{auth_subject:$auth_subject,email:($email|if length==0 then null else . end),name:($name|if length==0 then null else . end),status:$status}'
}

body_key_generate() {
  local label expires
  label="$(prompt_required Label)"
  read -r -p 'Expires at [optional; blank means never/policy default]: ' expires
  jq -nc --arg label "$label" --arg expires "$expires" '{label:$label,expires_at:($expires|if length==0 then null else . end)}'
}

run_account() {
  local mode="" id reason body path status page limit
  while (($#)); do
    case "$1" in
      --me) mode=me ;;
      keys) mode=keys ;;
      key) mode=key ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --account; return ;;
      *) usage_error "Unknown account option: $1" ;;
    esac
    shift
  done
  require_base_config
  case "$mode" in
    me|'') request GET account/me admin ;;
    keys) path='account/keys/list'; if [[ "$PARAMS" == true ]]; then status="$(prompt_optional Status)"; page="$(prompt_optional Page)"; limit="$(prompt_optional Limit)"; path="$(append_query "$path" status "$status")"; path="$(append_query "$path" page "$page")"; path="$(append_query "$path" limit "$limit")"; fi; request GET "$path" admin ;;
    key)
      read -r -p 'Action [get/generate/revoke]: ' mode
      case "$mode" in
        get) id="$(prompt_required 'Key ID')"; request GET "account/keys/$(urlencode "$id")" admin ;;
        generate) body="$(body_key_generate)"; request POST account/keys/gen admin "$body" ;;
        revoke) id="$(prompt_required 'Key ID')"; reason="$(prompt_required Reason)"; body="$(jq -nc --arg reason "$reason" '{reason:$reason}')"; confirm_action 'Revoke this API key?'; request POST "account/keys/$(urlencode "$id")/revoke" admin "$body" ;;
        *) usage_error 'Action must be get, generate, or revoke.' ;;
      esac
      ;;
  esac
}

run_admin() {
  local mode="" submode="" type="all" id account_id key_id label expires reason service date title provider path body page limit from to namespace
  while (($#)); do
    case "$1" in
      home|cache|franchise|diagnostics|logs|keys|accounts) mode="$1" ;;
      build|backfill|warm-cache|clear|register|list|read|upload|flush|get|generate|revoke|create|--list|--read|--upload|--flush|--generate|--revoke|--create|--keys) submode="${1#--}" ;;
      --movie) type=movie ;;
      --tv) type=tv ;;
      --anime) type=anime ;;
      --all) type=all ;;
      --wait) submode=wait ;;
      --params) PARAMS=true ;;
      --confirm) CONFIRM=true ;;
      --raw) RAW=true ;;
      --help) help_group --admin; return ;;
      *) usage_error "Unknown admin option: $1" ;;
    esac
    shift
  done
  require_base_config
  case "$mode" in
    '') request GET admin admin ;;
    home)
      case "$submode" in
        build|wait|'') path="admin/home/build?type=$type"; [[ "$submode" == wait ]] && path="$(append_query "$path" wait true)"; confirm_action 'Build homepage?'; request POST "$path" admin ;;
        backfill) path=admin/home/backfill; if [[ "$PARAMS" == true ]]; then limit="$(prompt_optional Limit)"; path="$(append_query "$path" limit "$limit")"; fi; confirm_action 'Run metadata backfill?'; request POST "$path" admin ;;
        warm-cache) confirm_action 'Warm homepage cache?'; request POST "admin/home/warm-cache?type=$type" admin ;;
        *) usage_error 'Unknown admin home action.' ;;
      esac
      ;;
    cache) [[ "$submode" == clear || -z "$submode" ]] || usage_error 'Unknown cache action.'; confirm_action 'Clear API cache?'; request POST admin/cache/clear admin ;;
    franchise) [[ "$submode" == register ]] || usage_error 'Use --register/register for administrative franchise registration.'; read -r -p 'Franchise reference [optional]: ' id; path=admin/franchise/register; [[ -n "$id" ]] && path="$(append_query "$path" id "$id")"; confirm_action 'Register franchise?'; request POST "$path" admin ;;
    diagnostics) provider="$(prompt_required Provider)"; type="$(prompt_type)"; title="$(prompt_required Title)"; path="admin/diagnostics/$(urlencode "$provider")/$type?title=$(urlencode "$title")"; request GET "$path" admin ;;
    logs)
      case "$submode" in
        list|'') path=admin/logs; if [[ "$PARAMS" == true ]]; then service="$(prompt_optional Service)"; from="$(prompt_optional From)"; to="$(prompt_optional To)"; page="$(prompt_optional Page)"; limit="$(prompt_optional Limit)"; path="$(append_query "$path" service "$service")"; path="$(append_query "$path" from "$from")"; path="$(append_query "$path" to "$to")"; path="$(append_query "$path" page "$page")"; path="$(append_query "$path" limit "$limit")"; fi; request GET "$path" admin ;;
        read) service="$(prompt_required Service)"; date="$(prompt_date)"; path="admin/logs/$service/$date"; if [[ "$PARAMS" == true ]]; then path="$(append_query "$path" level "$(prompt_optional Level)")"; path="$(append_query "$path" namespace "$(prompt_optional Namespace)")"; fi; request GET "$path" admin ;;
        upload) service="$(prompt_required Service)"; date="$(prompt_date)"; local file; file="$(prompt_required 'Log file path')"; [[ -f "$file" ]] || runtime_error 'Log file does not exist.'; body="$(jq -nc --arg service "$service" --arg date "$date" --rawfile content "$file" '{service:$service,date:$date,content:$content}')"; confirm_action 'Upload log archive?'; request POST admin/logs/upload admin "$body" ;;
        flush) service="$(prompt_required Service)"; confirm_action 'Flush service log?'; request POST "admin/logs/flush?service=$(urlencode "$service")" admin ;;
        *) usage_error 'Log action must be list, read, upload, or flush.' ;;
      esac
      ;;
    keys)
      case "$submode" in
        list|'') path=admin/keys/list; if [[ "$PARAMS" == true ]]; then path="$(append_query "$path" status "$(prompt_optional Status)")"; path="$(append_query "$path" account_id "$(prompt_optional Account-ID)")"; path="$(append_query "$path" page "$(prompt_optional Page)")"; path="$(append_query "$path" limit "$(prompt_optional Limit)")"; fi; request GET "$path" admin ;;
        get) key_id="$(prompt_required 'Key ID')"; request GET "admin/keys/$(urlencode "$key_id")" admin ;;
        generate) account_id="$(prompt_required 'Account ID')"; body="$(body_key_generate)"; request POST "admin/accounts/$(urlencode "$account_id")/keys/gen" admin "$body" ;;
        revoke) key_id="$(prompt_required 'Key ID')"; reason="$(prompt_required Reason)"; body="$(jq -nc --arg reason "$reason" '{reason:$reason}')"; confirm_action 'Revoke this API key?'; request POST "admin/keys/$(urlencode "$key_id")/revoke" admin "$body" ;;
        *) usage_error 'Key action must be list, get, generate, or revoke.' ;;
      esac
      ;;
    accounts)
      if [[ "$submode" == create ]]; then body="$(body_account_create)"; request POST admin/accounts/create admin "$body";
      elif [[ "$submode" == keys || "$submode" == list || "$submode" == generate ]]; then
        account_id="$(prompt_required 'Account ID')"
        if [[ "$submode" == keys ]]; then read -r -p 'Key action [list/generate]: ' submode; fi
        case "$submode" in
          list) path="admin/accounts/$(urlencode "$account_id")/keys/list"; if [[ "$PARAMS" == true ]]; then page="$(prompt_optional Page)"; limit="$(prompt_optional Limit)"; path="$(append_query "$path" page "$page")"; path="$(append_query "$path" limit "$limit")"; fi; request GET "$path" admin ;;
          generate) body="$(body_key_generate)"; request POST "admin/accounts/$(urlencode "$account_id")/keys/gen" admin "$body" ;;
          *) usage_error 'Key action must be list or generate.' ;;
        esac
      else usage_error 'Use --create or --keys.'; fi
      ;;
    *) usage_error 'Unknown admin command group.' ;;
  esac
}

run_internal() {
  local mode="" type title spun_id tmdb_id anilist_id mal_id moviebox_id year season episode provider service path query
  while (($#)); do
    case "$1" in
      health|stream|download|diagnostics|logs) mode="$1" ;;
      --flush) mode=logs ;;
      --movie) type=movie ;;
      --tv) type=tv ;;
      --anime) type=anime ;;
      --raw) RAW=true ;;
      --help) help_group --internal; return ;;
      *) usage_error "Unknown internal option: $1" ;;
    esac
    shift
  done
  require_internal_config
  case "$mode" in
    health|'') request GET health internal ;;
    stream|download)
      [[ -n "${type:-}" ]] || type="$(prompt_type)"
      spun_id="$(prompt_required 'Spün ID')"
      title="$(prompt_required Title)"
      if [[ "$type" == anime ]]; then
        anilist_id="$(prompt_number 'AniList ID')"
      else
        tmdb_id="$(prompt_optional 'TMDB ID')"
        moviebox_id="$(prompt_optional 'MovieBox ID')"
        if [[ -z "$tmdb_id" && -z "$moviebox_id" ]]; then
          printf 'Error: TMDB ID or MovieBox ID is required.\n' >&2
          tmdb_id="$(prompt_number 'TMDB ID')"
        fi
        [[ "$type" == tv ]] && { season="$(prompt_number Season)"; episode="$(prompt_number Episode)"; }
      fi
      path="$mode?type=$type"
      path="$(append_query "$path" spun_id "$spun_id")"
      path="$(append_query "$path" title "$title")"
      path="$(append_query "$path" tmdb_id "$tmdb_id")"
      path="$(append_query "$path" anilist_id "$anilist_id")"
      path="$(append_query "$path" moviebox_id "$moviebox_id")"
      path="$(append_query "$path" season "${season:-}")"
      path="$(append_query "$path" episode "${episode:-}")"
      request GET "$path" internal
      ;;
    diagnostics) provider="$(prompt_required Provider)"; type="$(prompt_type)"; title="$(prompt_required Title)"; path="admin/diagnostics/$(urlencode "$provider")/$type?title=$(urlencode "$title")"; request GET "$path" internal ;;
    logs) service="$(prompt_required Service)"; confirm_action 'Flush service log?'; request POST "admin/logs/flush?service=$(urlencode "$service")" internal ;;
    *) usage_error 'Unknown internal command.' ;;
  esac
}

run_generic_request() {
  local method path auth=admin body="" query key value
  method="${1:-}"
  path="${2:-}"
  [[ -n "$method" && -n "$path" ]] || usage_error 'Usage: spn request GET|POST|PUT|PATCH|DELETE /path'
  shift 2 || true
  while (($#)); do
    case "$1" in
      --auth) shift; auth="${1:-}" ;;
      --params) PARAMS=true ;;
      --body) shift; body="${1:-}" ;;
      --body-file) shift; body="$(cat "${1:-}")" ;;
      --confirm) CONFIRM=true ;;
      --raw) RAW=true ;;
      --param) shift; key="${1%%=*}"; value="${1#*=}"; path="$(append_query "$path" "$key" "$value")" ;;
      --header) shift ;; # deliberately ignored; the simple client owns auth headers
      *) usage_error "Unknown request option: $1" ;;
    esac
    shift
  done
  case "$auth" in admin) require_base_config ;; internal) require_internal_config ;; none) [[ -n "$SPN_API_BASE_URL" ]] || runtime_error 'Worker API URL is not configured.' ;;     *) usage_error 'Auth must be admin, internal, or none.' ;; esac
  if [[ "$method" != GET && "$method" != HEAD && "$method" != OPTIONS ]]; then confirm_action 'Send request?' ; fi
  request "$method" "$path" "$auth" "$body"
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    help|-h|--help)
      if (($#)); then help_group "$1"; else help_global; fi
      return 0
      ;;
    config) config_menu; return 0 ;;
  esac

  require_dependency curl
  require_dependency jq
  load_config
  PARAMS=false
  CONFIRM=false
  RAW=false

  case "$command" in
    health) require_worker_url; request GET health none ;;
    endpoints) require_base_config; endpoint_registry ;;
    search) require_base_config; run_search "$@" ;;
    info) require_base_config; run_info "$@" ;;
    discover) require_base_config; run_discover "$@" ;;
    anime) require_base_config; run_anime "$@" ;;
    stream) require_base_config; run_stream "$@" ;;
    download) require_base_config; run_download "$@" ;;
    subtitles) require_base_config; run_subtitles "$@" ;;
    resolve) require_base_config; run_resolve "$@" ;;
    home) require_base_config; run_home "$@" ;;
    similar) require_base_config; run_similar "$@" ;;
    franchise) require_base_config; run_franchise "$@" ;;
    proxy) require_base_config; run_proxy "$@" ;;
    account) run_account "$@" ;;
    admin) run_admin "$@" ;;
    internal) run_internal "$@" ;;
    request) run_generic_request "$@" ;;
    *) printf 'Error: Unknown command: %s\n' "$command" >&2; help_global; exit 2 ;;
  esac
}

main "$@"
