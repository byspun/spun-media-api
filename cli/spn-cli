run_search() {
  local mode="" query path page
  while (($#)); do
    case "$1" in
      --movie) mode=movie ;;
      --tv) mode=tv ;;
      --anime) mode=anime ;;
      --suggestions) mode=suggestions ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --search; return ;;
      *) usage_error "Unknown search option: $1" ;;
    esac
    shift
  done
  query="$(prompt_required Query)"
  case "$mode" in
    movie|tv|anime) path="search/$mode" ;;
    suggestions) path='search/suggestions' ;;
    '') path='search' ;;
    *) usage_error 'Invalid search mode.' ;;
  esac
  path="$(append_query "$path" q "$query")"
  if [[ "$PARAMS" == true ]]; then
    page="$(prompt_optional Page)"
    path="$(append_query "$path" page "$page")"
  fi
  request GET "$path" admin
}

run_info() {
  local mode="" id season path
  while (($#)); do
    case "$1" in
      --cast) mode=cast ;;
      --episodes) mode=episodes ;;
      --related) mode=related ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --info; return ;;
      *) usage_error "Unknown info option: $1" ;;
    esac
    shift
  done
  id="$(prompt_required 'Spün ID')"
  path="info/$(urlencode "$id")"
  [[ -n "$mode" ]] && path="$path/$mode"
  if [[ "$PARAMS" == true && "$mode" == episodes ]]; then
    season="$(prompt_optional Season)"
    path="$(append_query "$path" season "$season")"
  fi
  request GET "$path" admin
}

run_discover() {
  local mode="" value type page genre="" path
  while (($#)); do
    case "$1" in
      --trending|--popular|--new|--genres|--studios|--studio) mode="${1#--}" ;;
      --genre) genre='prompt' ;;
      --movie) type=movie ;;
      --tv) type=tv ;;
      --anime) type=anime ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --discover; return ;;
      *) usage_error "Unknown discover option: $1" ;;
    esac
    shift
  done
  [[ -n "$mode" ]] || mode=trending
  if [[ "$mode" == studio ]]; then
    value="$(prompt_required 'Studio ID')"
    path="discover/studio/$(urlencode "$value")"
  elif [[ "$mode" == genres || "$mode" == studios || "$mode" == trending || "$mode" == popular || "$mode" == new ]]; then
    path="discover/$mode"
  else
    [[ -n "${type:-}" ]] || type="$(prompt_type)"
    path="discover/$type"
  fi
  if [[ "$genre" == prompt ]]; then
    [[ -n "${type:-}" ]] || type="$(prompt_type)"
    value="$(prompt_required Genre)"
    path="discover/$type"
    path="$(append_query "$path" genre "$value")"
  elif [[ "$PARAMS" == true ]]; then
    page="$(prompt_optional Page)"
    path="$(append_query "$path" page "$page")"
  fi
  if [[ "$PARAMS" == true && "$genre" == prompt ]]; then
    page="$(prompt_optional Page)"
    path="$(append_query "$path" page "$page")"
  fi
  if [[ -n "${type:-}" && "$mode" != studio && "$mode" != genres && "$mode" != studios && "$genre" != prompt ]]; then
    path="$(append_query "$path" type "$type")"
  fi
  request GET "$path" admin
}

run_anime() {
  local mode="" value page year season id path ranking
  while (($#)); do
    case "$1" in
      --seasons|--season|--schedule|--rankings|--airing|--upcoming|--format|--demographic|--source|--genre|--studios|--studio|--themes|--fillers|--franchise|--characters|--related) mode="${1#--}" ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --anime; return ;;
      *) usage_error "Unknown anime option: $1" ;;
    esac
    shift
  done
  [[ -n "$mode" ]] || { mode=seasons; printf 'Action not specified; using seasons.\n' >&2; }
  case "$mode" in
    seasons|schedule|airing|upcoming|studios) path="anime/$mode" ;;
    season) year="$(prompt_number Year)"; season="$(prompt_required Season)"; path="anime/seasons/$(urlencode "$year")/$(urlencode "$season")" ;;
    rankings)
      ranking="$(prompt_required 'Ranking [alltime/popular/season/genre]')"
      case "$ranking" in
        alltime|popular) path="anime/rankings/$ranking" ;;
        season) year="$(prompt_number Year)"; season="$(prompt_required Season)"; path="anime/rankings/season/$(urlencode "$year")/$(urlencode "$season")" ;;
        genre) value="$(prompt_required Genre)"; path="anime/rankings/genre/$(urlencode "$value")" ;;
        *) usage_error 'Ranking must be alltime, popular, season, or genre.' ;;
      esac
      ;;
    format|demographic|source|genre) value="$(prompt_required "${mode^}")"; path="anime/$mode/$(urlencode "$value")" ;;
    studio) value="$(prompt_required 'Studio ID')"; path="anime/studio/$(urlencode "$value")" ;;
    themes|fillers|franchise|characters|related) id="$(prompt_required 'Spün ID')"; path="anime/$(urlencode "$id")/$mode" ;;
    *) usage_error 'Unknown anime action.' ;;
  esac
  if [[ "$PARAMS" == true ]]; then
    page="$(prompt_optional Page)"
    path="$(append_query "$path" page "$page")"
  fi
  request GET "$path" admin
}

run_stream() {
  local type="" id season episode path
  while (($#)); do
    case "$1" in
      --movie) type=movie ;;
      --tv) type=tv ;;
      --anime) type=anime ;;
      --season) season='prompt' ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --stream; return ;;
      *) usage_error "Unknown stream option: $1" ;;
    esac
    shift
  done
  [[ -n "$type" ]] || type="$(prompt_type)"
  id="$(prompt_required 'Spün ID')"
  case "$type" in
    movie) path="stream/movie/$(urlencode "$id")" ;;
    tv) season="$(prompt_number Season)"; episode="$(prompt_number Episode)"; path="stream/tv/$(urlencode "$id")/$season/$episode" ;;
    anime)
      if [[ "${season:-}" == prompt ]]; then season="$(prompt_number Season)"; else season=1; fi
      episode="$(prompt_number Episode)"
      path="stream/anime/$(urlencode "$id")/$season/$episode"
      ;;
  esac
  request GET "$path" admin
}

run_download() {
  local type="" id season episode path all=false
  while (($#)); do
    case "$1" in
      --movie) type=movie ;;
      --tv) type=tv ;;
      --anime) type=anime ;;
      --all) all=true ;;
      --episode) episode='prompt' ;;
      --params) PARAMS=true ;;
      --raw) RAW=true ;;
      --help) help_group --download; return ;;
      *) usage_error "Unknown download option: $1" ;;
    esac
    shift
  done
  [[ -n "$type" ]] || type="$(prompt_type)"
  id="$(prompt_required 'Spün ID')"
  if [[ "$type" == movie ]]; then
    path="download/movie/$(urlencode "$id")"
  elif [[ "$all" == true ]]; then
    path="download/$type/$(urlencode "$id")"
  else
    if [[ "${episode:-}" == prompt ]]; then
      season="$(prompt_number Season)"
      episode="$(prompt_number Episode)"
      path="download/$type/$(urlencode "$id")/$season/$episode"
    else
      season="$(prompt_optional Season)"
      if [[ -n "$season" ]]; then
        episode="$(prompt_number Episode)"
        path="download/$type/$(urlencode "$id")/$season/$episode"
      else
        path="download/$type/$(urlencode "$id")"
      fi
    fi
  fi
  request GET "$path" admin
}

