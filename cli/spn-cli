#!/usr/bin/env bash
# Spün Media API CLI
# Standalone Bash client for the Spün Media API.
# Requires: curl, jq

set -u

CONFIG_FILE="${SPN_CONFIG_FILE:-$HOME/.spn.env}"
SCRIPT_NAME="spn"

# Configuration values are loaded after help/config handling so those commands
# remain usable before the CLI has been configured.
SPN_API_BASE_URL=""
SPN_ADMIN_KEY=""
SPN_RENDER_BASE_URL=""
SPN_INTERNALS_KEY=""

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi
  SPN_API_BASE_URL="${SPN_API_BASE_URL:-}"
  SPN_ADMIN_KEY="${SPN_ADMIN_KEY:-}"
  SPN_RENDER_BASE_URL="${SPN_RENDER_BASE_URL:-}"
  SPN_INTERNALS_KEY="${SPN_INTERNALS_KEY:-}"
}

usage_error() {
  printf 'Error: %s\n' "$1" >&2
  exit 2
}

runtime_error() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

require_dependency() {
  command -v "$1" >/dev/null 2>&1 || runtime_error "$1 is required. Install it in Termux first."
}

require_worker_url() {
  [[ -n "$SPN_API_BASE_URL" ]] || { printf 'Worker API URL is not configured.\nRun: %s config\n' "$SCRIPT_NAME" >&2; exit 3; }
}

require_base_config() {
  local missing=()
  [[ -n "$SPN_API_BASE_URL" ]] || missing+=("SPN_API_BASE_URL")
  [[ -n "$SPN_ADMIN_KEY" ]] || missing+=("SPN_ADMIN_KEY")
  if ((${#missing[@]})); then
    printf 'Configuration incomplete.\nMissing: %s\nRun: %s config\n' "${missing[*]}" "$SCRIPT_NAME" >&2
    exit 3
  fi
}

require_internal_config() {
  local missing=()
  [[ -n "$SPN_RENDER_BASE_URL" ]] || missing+=("SPN_RENDER_BASE_URL")
  [[ -n "$SPN_INTERNALS_KEY" ]] || missing+=("SPN_INTERNALS_KEY")
  if ((${#missing[@]})); then
    printf 'Internal configuration incomplete.\nMissing: %s\nRun: %s config\n' "${missing[*]}" "$SCRIPT_NAME" >&2
    exit 3
  fi
}

trim_slash() {
  printf '%s' "${1%/}"
}

urlencode() {
  jq -rn --arg value "$1" '$value|@uri'
}

mask_secret() {
  local value="$1"
  if [[ -z "$value" ]]; then
    printf '[not configured]'
  elif ((${#value} <= 4)); then
    printf 'configured'
  else
    printf 'configured (%s...)' "${value:0:4}"
  fi
}

write_config_value() {
  local name="$1" value="$2" tmp line replaced=false escaped
  mkdir -p "$(dirname "$CONFIG_FILE")"
  touch "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  tmp="${CONFIG_FILE}.tmp.$$"
  printf -v escaped '%q' "$value"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$name="* ]]; then
      printf '%s=%s\n' "$name" "$escaped" >> "$tmp"
      replaced=true
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$CONFIG_FILE"
  if [[ "$replaced" != true ]]; then
    printf '%s=%s\n' "$name" "$escaped" >> "$tmp"
  fi
  mv "$tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  printf 'Saved.\n'
}

clear_config_value() {
  local name="$1" tmp
  [[ -f "$CONFIG_FILE" ]] || return 0
  tmp="${CONFIG_FILE}.tmp.$$"
  awk -v key="$name" '$0 !~ "^" key "=" { print }' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  printf 'Removed.\n'
}

config_status() {
  case "$1" in
    SPN_API_BASE_URL) [[ -n "$SPN_API_BASE_URL" ]] && printf '%s' "$SPN_API_BASE_URL" || printf '[not configured]' ;;
    SPN_ADMIN_KEY) mask_secret "$SPN_ADMIN_KEY" ;;
    SPN_RENDER_BASE_URL) [[ -n "$SPN_RENDER_BASE_URL" ]] && printf '%s' "$SPN_RENDER_BASE_URL" || printf '[not configured]' ;;
    SPN_INTERNALS_KEY) mask_secret "$SPN_INTERNALS_KEY" ;;
  esac
}

config_menu() {
  load_config
  while true; do
    cat <<EOF

Spün Media API Configuration
────────────────────────────

1. Worker API URL          $(config_status SPN_API_BASE_URL)
2. Admin key               $(config_status SPN_ADMIN_KEY)
3. Render API URL          $(config_status SPN_RENDER_BASE_URL)
4. Internals key           $(config_status SPN_INTERNALS_KEY)
5. View configuration
6. Clear a variable
7. Exit

EOF
    local choice value variable
    read -r -p 'Select a variable by entering its number: ' choice
    case "$choice" in
      1)
        read -r -p 'Worker API URL: ' value
        [[ -n "$value" ]] || { printf 'Error: Worker API URL is required.\n'; continue; }
        write_config_value SPN_API_BASE_URL "$(trim_slash "$value")"
        SPN_API_BASE_URL="$(trim_slash "$value")"
        ;;
      2)
        read -r -s -p 'X-ADMIN-KEY: ' value; printf '\n'
        [[ -n "$value" ]] || { printf 'Error: Admin key is required.\n'; continue; }
        write_config_value SPN_ADMIN_KEY "$value"
        SPN_ADMIN_KEY="$value"
        ;;
      3)
        read -r -p 'Render API URL: ' value
        [[ -n "$value" ]] || { printf 'Error: Render API URL is required.\n'; continue; }
        write_config_value SPN_RENDER_BASE_URL "$(trim_slash "$value")"
        SPN_RENDER_BASE_URL="$(trim_slash "$value")"
        ;;
      4)
        read -r -s -p 'X-INTERNALS-KEY: ' value; printf '\n'
        [[ -n "$value" ]] || { printf 'Error: Internals key is required.\n'; continue; }
        write_config_value SPN_INTERNALS_KEY "$value"
        SPN_INTERNALS_KEY="$value"
        ;;
      5)
        printf '\nCurrent configuration:\n\n'
        printf '1. Worker API URL          %s\n' "$(config_status SPN_API_BASE_URL)"
        printf '2. Admin key               %s\n' "$(config_status SPN_ADMIN_KEY)"
        printf '3. Render API URL          %s\n' "$(config_status SPN_RENDER_BASE_URL)"
        printf '4. Internals key           %s\n\n' "$(config_status SPN_INTERNALS_KEY)"
        ;;
      6)
        read -r -p 'Variable to clear [1-4]: ' variable
        case "$variable" in
          1) write_config_value SPN_API_BASE_URL '' ; SPN_API_BASE_URL='' ;;
          2) write_config_value SPN_ADMIN_KEY '' ; SPN_ADMIN_KEY='' ;;
          3) write_config_value SPN_RENDER_BASE_URL '' ; SPN_RENDER_BASE_URL='' ;;
          4) write_config_value SPN_INTERNALS_KEY '' ; SPN_INTERNALS_KEY='' ;;
          *) printf 'Error: Choose a variable from 1 to 4.\n' ;;
        esac
        ;;
      7) printf 'Configuration saved to %s.\n' "$CONFIG_FILE"; return 0 ;;
      *) printf 'Error: Choose an option from 1 to 7.\n' ;;
    esac
  done
}

prompt_required() {
  local label="$1" value
  while true; do
    read -r -p "$label: " value
    if [[ -n "${value//[[:space:]]/}" ]]; then
      printf '%s' "$value"
      return 0
    fi
    printf 'Error: %s is required.\n' "$label" >&2
  done
}

prompt_secret_required() {
  local label="$1" value
  while true; do
    read -r -s -p "$label: " value; printf '\n' >&2
    if [[ -n "${value//[[:space:]]/}" ]]; then
      printf '%s' "$value"
      return 0
    fi
    printf 'Error: %s is required.\n' "$label" >&2
  done
}

prompt_optional() {
  local label="$1" value
  read -r -p "$label [optional]: " value
  printf '%s' "$value"
}

prompt_number() {
  local label="$1" value
  while true; do
    read -r -p "$label: " value
    if [[ "$value" =~ ^[0-9]+$ ]] && ((value > 0)); then
      printf '%s' "$value"
      return 0
    fi
    printf 'Error: %s must be a positive integer.\n' "$label" >&2
  done
}

prompt_type() {
  local value
  while true; do
    read -r -p 'Type [movie/tv/anime]: ' value
    case "$value" in
      movie|tv|anime) printf '%s' "$value"; return 0 ;;
      *) printf 'Error: Type must be movie, tv, or anime.\n' >&2 ;;
    esac
  done
}

prompt_home_type() {
  local value
  while true; do
    read -r -p 'Type [all/movie/tv/anime]: ' value
    case "$value" in
      all|movie|tv|anime) printf '%s' "$value"; return 0 ;;
      *) printf 'Error: Type must be all, movie, tv, or anime.\n' >&2 ;;
    esac
  done
}

prompt_date() {
  local value
  while true; do
    read -r -p 'Date [YYYY-MM-DD]: ' value
    if [[ "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      printf '%s' "$value"
      return 0
    fi
    printf 'Error: Date must use YYYY-MM-DD.\n' >&2
  done
}

confirm_action() {
  local prompt="$1" value
  if [[ "${CONFIRM:-false}" == true ]]; then return 0; fi
  read -r -p "$prompt Type CONFIRM to continue: " value
  [[ "$value" == CONFIRM ]] || runtime_error 'Action cancelled.'
}

format_response() {
  local file="$1" status="$2" content_type body
  content_type="$(grep -i '^content-type:' "$file.headers" 2>/dev/null | tail -1 | tr -d '\r' || true)"
  body="$(cat "$file")"
  if [[ "$status" =~ ^2 ]]; then
    if [[ "$content_type" == *text/plain* ]]; then
      printf '%s\n' "$body"
    elif jq empty >/dev/null 2>&1 <<<"$body"; then
      if [[ "${RAW:-false}" == true ]]; then printf '%s\n' "$body"; else jq . <<<"$body"; fi
    else
      printf '%s\n' "$body"
    fi
    return 0
  fi

  if jq empty >/dev/null 2>&1 <<<"$body"; then jq . <<<"$body"; else printf '%s\n' "$body"; fi
  return 1
}

request() {
  local method="$1" path="$2" auth="${3:-admin}" body="${4:-}" base url tmp status
  case "$auth" in
    admin) base="$(trim_slash "$SPN_API_BASE_URL")" ;;
    none) base="$(trim_slash "$SPN_API_BASE_URL")" ;;
    internal) base="$(trim_slash "$SPN_RENDER_BASE_URL")" ;;
    *) usage_error 'Unknown authentication mode.' ;;
  esac
  if [[ "$auth" != internal && "$path" == /v1/* && "$base" == */v1 ]]; then
    path="${path#/v1/}"
  fi
  url="${base}/${path#/}"
  tmp="$(mktemp)"
  local -a args
  args=(-sS -L --max-redirs 5 --proto '=http,https' --proto-redir '=https' -X "$method" "$url" -H 'Accept: application/json, text/plain;q=0.9')
  case "$auth" in
    admin) args+=(-H "X-Admin-Key: $SPN_ADMIN_KEY") ;;
    internal) args+=(-H "X-Internals-Key: $SPN_INTERNALS_KEY") ;;
    none) : ;;
  esac
  if [[ -n "$body" ]]; then
    args+=(-H 'Content-Type: application/json' --data "$body")
  fi
  if ! status="$(curl "${args[@]}" -o "$tmp" -D "${tmp}.headers" -w '%{http_code}')"; then
    rm -f "$tmp" "${tmp}.headers"
    printf 'Network error while requesting %s.\n' "$url" >&2
    exit 4
  fi
  format_response "$tmp" "$status"
  local result=$?
  rm -f "$tmp" "${tmp}.headers"
  if [[ "$status" =~ ^[0-9]{3}$ ]] && [[ ! "$status" =~ ^2 ]]; then
    printf 'HTTP %s\n' "$status" >&2
    return 1
  fi
  return "$result"
}

parse_params_flag() {
  PARAMS=false
  CONFIRM=false
  RAW=false
  while (($#)); do
    case "$1" in
      --params) PARAMS=true ;;
      --confirm) CONFIRM=true ;;
      --raw) RAW=true ;;
      --help) return 10 ;;
      --*) usage_error "Unknown option: $1" ;;
    esac
    shift
  done
  return 0
}

append_query() {
  local path="$1" key="$2" value="$3"
  [[ -n "$value" ]] || { printf '%s' "$path"; return; }
  if [[ "$path" == *\?* ]]; then printf '%s&%s=%s' "$path" "$key" "$(urlencode "$value")"; else printf '%s?%s=%s' "$path" "$key" "$(urlencode "$value")"; fi
}

