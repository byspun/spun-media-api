{
  "compilerOptions": {
    "target":            "ES2022",
    "module":            "ES2022",
    "moduleResolution":  "bundler",
    "lib":               ["ES2022"],
    "outDir":            "./dist",
    "rootDir":           "../",
    "strict":            false,
    "noUnusedLocals":    false,
    "noUnusedParameters": false,
    "skipLibCheck":      true,
    "esModuleInterop":   true
  },
    "include": ["./**/*.ts", "../logs/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
