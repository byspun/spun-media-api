# providers/.env.example
# Copy to .env and fill in values before running the providers backend.
# Never commit .env to version control.

# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Non-pooled connection string — used for direct queries in Node.js
NEON_DATABASE_URL=postgresql://user:password@host/dbname

# ─── Shared secret ────────────────────────────────────────────────────────────
# Must match X_SPUN_SECRET set in the Cloudflare Worker
X_SPUN_SECRET=e623c68057c15d037679e41ff6d3bd2fc0ae809c840fb7b6d1022e979ae51e23

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
