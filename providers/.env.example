# providers/.env.example
# Render provider service configuration. Never commit the real values.

# Shared Worker <-> Render authentication secret
X_SPUN_SECRET=replace-with-the-same-worker-secret

# User-built MovieBox API
MOVIEBOX_API_BASE=https://moviebox.byspun.xyz
MOVIEBOX_API_SECRET=replace-with-moviebox-api-secret

# Optional provider runtime values
TMDB_API_KEY=replace-with-tmdb-key
PORT=10000
NODE_ENV=production
